# 统一按文本处理、换行一律 LF —— 避免 Windows/macOS 协作时的整文件 diff 噪音。
* text=auto eol=lf

# 明确文本类型
*.js    text
*.mjs   text
*.json  text
*.yml   text
*.yaml  text
*.md    text
*.svg   text
*.patch text

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary

# 生成物在 diff / 语言统计里折叠
pnpm-lock.yaml    linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock         linguist-generated=true

# 记忆运行时数据（用户数据）：与 .gitignore 的「记忆运行时数据」规则对应。
# 正常情况下已被 .gitignore 挡住；这里再加一道，万一被强制提交，也不进 GitHub 语言统计。
.dsh-memory/** linguist-generated=true
runs.jsonl     linguist-generated=true
CONFLICTS.md   linguist-generated=true
